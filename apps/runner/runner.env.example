# Copy to apps/runner/runner.env (gitignored). The runner reads it on start.
# Real environment variables win over values in this file.

# --- Where the app runs ---
# Local dev Worker, or your deployed app, e.g. https://trading-analysis-agent.<you>.workers.dev
TAA_URL=http://localhost:8787
# Settings → Local AI runner → Create token. Treat it like a password.
TAA_RUNNER_TOKEN=

# --- Engines (your subscriptions; no API keys) ---
# Fallback order. CLIs that aren't installed are skipped.
#   antigravity  = Antigravity CLI `agy` (Google AI Pro/Ultra quota)
#   gemini-cli   = Gemini CLI `gemini` (sign in with Google; AI Pro gets higher limits)
#   claude-code  = Claude Code `claude` (your Claude subscription)
RUNNER_ENGINES=antigravity,gemini-cli,claude-code

# Models per tier. "fast" = quick analysis + analysts; "deep" = trader + portfolio manager.
# Empty = the CLI's default model. List Antigravity models with:  agy models
AGY_MODEL_FAST=gemini-3.8-flash-medium
AGY_MODEL_DEEP=
GEMINI_CLI_MODEL_FAST=
GEMINI_CLI_MODEL_DEEP=
CLAUDE_CODE_MODEL_FAST=haiku
CLAUDE_CODE_MODEL_DEEP=sonnet

# Optional full paths if the CLIs aren't on PATH.
AGY_BIN=
GEMINI_BIN=
CLAUDE_BIN=

# --- Behaviour ---
RUNNER_POLL_SECONDS=15
# Per model call. Deep mode makes 8 calls.
RUNNER_TIMEOUT_SECONDS=300
# How many CLI processes may run at once (deep mode runs the analysts in parallel).
RUNNER_MAX_PARALLEL=3
